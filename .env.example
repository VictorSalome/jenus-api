# ── GERAL (core/config.ts — infra genuinamente genérica, usada por qualquer app) ──
NODE_ENV=development
PORT=3001
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ── AUTH (compartilhado) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$10$...
JWT_ACCESS_SECRET=sua_chave_jwt_access_min_16_caracteres
JWT_REFRESH_SECRET=sua_chave_jwt_refresh_min_16_caracteres
SESSION_SECRET=sua_chave_secreta_aqui_min_32_caracteres

# ── BANCO ──
DATABASE_PATH=./data/promo-monitor.db

# ── TELEGRAM / DISCORD (promo/config.ts — específico do app promo) ──
API_ID=
API_HASH=
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/seu-webhook-aqui
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_GROUP_ID=
CHECK_INTERVAL_SECONDS=30
MIN_TIME_BETWEEN_MESSAGES=30
URGENT_ENABLED=true

# ── CURRÍCULO (curriculos/config/index.ts — específico do app curriculos) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
EMAIL_SEND_TIMEOUT_MS=20000
EMAIL_FROM=
EMAIL_SUBJECT=Candidatura para vaga de desenvolvedor
EMAIL_FROM_NAME=Sistema de Currículo
EMAIL_SUBJECT_TEMPLATE=Candidatura: {candidato} - {vaga}
EMAIL_REPLY_TO=
EMAIL_TESTE=
SMTP_CONFIG_FILE=./data/smtp-config.json
TEMP_DIR=./temp
DATA_DIR=./data
LOGS_DIR=./logs
PDF_MARGIN_TOP=72
PDF_MARGIN_BOTTOM=72
PDF_MARGIN_LEFT=72
PDF_MARGIN_RIGHT=72
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
TRUST_PROXY=true
