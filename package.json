{
  "name": "jenus-api",
  "version": "1.0.0",
  "description": "Jenus API - Backend geral modular (auth JWT, promo-monitor, curriculo-monitor)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && npx tsc && mkdir -p dist && cp -r src/curriculos dist/curriculos && mkdir -p data temp",
    "start": "node dist/index.js",
    "start:pm2": "pm2 start scripts/pm2.config.cjs",
    "stop:pm2": "pm2 stop scripts/pm2.config.cjs",
    "restart:pm2": "pm2 restart scripts/pm2.config.cjs",
    "logs:pm2": "pm2 logs promo-monitor",
    "deploy": "bash scripts/deploy-oracle.sh",
    "deploy:oracle": "bash scripts/deploy-oracle.sh"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^4.6.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.14.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "telegram": "^2.19.10",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}